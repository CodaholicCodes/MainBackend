{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./prisma/generated/client/client.js"]
    }
  },
  "include": ["src/**/*", "prisma/generated/client/**/*"]
}
